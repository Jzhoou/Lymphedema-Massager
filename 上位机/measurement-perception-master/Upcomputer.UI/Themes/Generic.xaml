<!-- Upcomputer.UI/Themes/Generic.xaml -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Upcomputer.UI.Controls">

    <!-- 压力仪表盘样式 -->
    <Style TargetType="{x:Type local:PressureGauge}">
        <Setter Property="Width" Value="150"/>
        <Setter Property="Height" Value="180"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:PressureGauge}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 背景弧 -->
                        <local:Arc x:Name="PART_BackgroundArc" 
                                   Grid.Row="0"
                                   Stroke="#D1D5DB" 
                                   StrokeThickness="16"
                                   StrokeStartLineCap="Round"
                                   StrokeEndLineCap="Round"/>

                        <!-- 数值弧 -->
                        <local:Arc x:Name="PART_ValueArc" 
                                   Grid.Row="0"
                                   Stroke="#3498DB" 
                                   StrokeThickness="14"
                                   StrokeStartLineCap="Round"
                                   StrokeEndLineCap="Round"/>

                        <!-- 中心数值 -->
                        <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                             <TextBlock x:Name="PART_ValueText" 
                                        Text="0.0" 
                                        FontSize="32" 
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{TemplateBinding Unit}" 
                                       FontSize="12" 
                                       Foreground="#888888"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 标题 -->
                        <TextBlock x:Name="PART_TitleText" 
                                   Grid.Row="1"
                                   Text="{TemplateBinding Title}"
                                   FontSize="12"
                                   Foreground="#CCCCCC"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0"/>

                        <!-- 最大
                        ,<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding DataContext.MaxValue, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='Max:{0:F0}'}" 
                                                FontSize="10" Foreground="#888888" Margin="5,0"/>
                            <TextBlock Text="{Binding DataContext.Threshold, RelativeSource={RelativeSource AncestorType=Window}, StringFormat='阈值:{0:F0}'}" 
                                                FontSize="10" Foreground="#888888" Margin="5,0"/>
                        </StackPanel>/阈值 -->

                        <!-- 最大/阈值 -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Max:" FontSize="10" Foreground="#888888" Margin="5,0"/>
                            <TextBlock Text="{Binding MaxValue, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:F0}}" FontSize="10" Foreground="#888888" Margin="0,0,5,0"/>
                            <TextBlock Text="阈值:" FontSize="10" Foreground="#888888" Margin="5,0"/>
                            <TextBlock Text="{Binding Threshold, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:F0}}" FontSize="10" Foreground="#888888" Margin="0,0,5,0"/>
                        </StackPanel>

                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>